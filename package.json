{
  "name": "zapbridge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "vercel-build": "pnpm migrate:up && next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js -m migrations -d DATABASE_URL_UNPOOLED",
    "migrate:up": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations -d DATABASE_URL_UNPOOLED",
    "migrate:down": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations -d DATABASE_URL_UNPOOLED",
    "migrate:create": "DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config node_modules/node-pg-migrate/bin/node-pg-migrate.js create -m migrations",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:seed-dev": "tsx scripts/seed-dev-admin.ts",
    "check:env": "node scripts/check-env.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@auth/pg-adapter": "^1.11.2",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@sentry/nextjs": "^10.65.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "@vercel/sandbox": "^2.9.2",
    "@vercel/speed-insights": "^2.0.0",
    "antd": "^5.29.3",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "dayjs": "^1.11.21",
    "debug": "^4.4.3",
    "dodopayments": "^2.42.2",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "nanoid": "^5.1.9",
    "next": "16.2.3",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "0.4.6",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.4",
    "recharts": "2.15.2",
    "resend": "^6.12.3",
    "sonner": "2.0.3",
    "standardwebhooks": "^1.0.0",
    "swr": "^2.4.1",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.1.12",
    "@types/bcryptjs": "^3.0.0",
    "@types/debug": "^4.1.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.7.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "node-pg-migrate": "^8.0.4",
    "tailwindcss": "4.1.12",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "undici": "^8.1.0",
    "vitest": "^3.2.6"
  }
}
